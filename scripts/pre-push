#!/usr/bin/env bash
# Push gate (no CI): a clean detached worktree of the commit being pushed (local sha
# from the refs git supplies on stdin; HEAD when run directly), beside the repo so
# ../bennett-isa-spec resolves. Runs cargo test in the validator crate and the dialect
# gate scripts/dialect_check_v02.py (all 0.2 families; exits 1 on any failed or blocked
# check). Never tests the possibly dirty working tree.
set -euo pipefail
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE DISPLAY WAYLAND_DISPLAY DBUS_SESSION_BUS_ADDRESS BROWSER
script_dir="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
root="$(git -C "$script_dir" rev-parse --show-toplevel)"
shas=()
if [ ! -t 0 ]; then
  while read -r -t 10 _ref sha _rref _rsha; do
    case "$sha" in ''|*[!0-9a-f]*|0000000000000000000000000000000000000000) continue;; esac
    shas+=("$sha")
  done || true
fi
if [ "${#shas[@]}" -eq 0 ]; then shas=("$(git -C "$root" rev-parse HEAD)"); fi
declare -A seen=()
status=0
for sha in "${shas[@]}"; do
  sha="$(git -C "$root" rev-parse --verify "${sha}^{commit}")"
  [ -n "${seen[$sha]:-}" ] && continue
  seen[$sha]=1
  wt="$(dirname "$root")/$(basename "$root")-gate-${sha:0:12}"
  cleanup() {
    git -C "$root" worktree remove --force "$wt" >/dev/null 2>&1 || true
    rm -rf "$wt"
    git -C "$root" worktree prune
  }
  cleanup
  mkdir -p "$root/.tmp/gate-target" "$root/scripts/.tmp"
  trap cleanup EXIT
  git -C "$root" worktree add --detach "$wt" "$sha" >/dev/null
  echo "pre-push: gating $sha in $wt" >&2
  mkdir -p "$wt/scripts/.tmp"
  # Reuse the interpreter snapshots the checker builds under scripts/.isa-ref (gitignored, slow to rebuild).
  if [ -d "$root/scripts/.isa-ref" ] && [ ! -e "$wt/scripts/.isa-ref" ]; then ln -s "$root/scripts/.isa-ref" "$wt/scripts/.isa-ref"; fi
  gate() { env TMPDIR="$wt/scripts/.tmp" CARGO_TARGET_DIR="$root/.tmp/gate-target" "$@"; }
  run_gate() {
    local m
    for m in $(env -C "$wt" find . -name Cargo.toml -not -path './scripts/.isa-ref/*' -not -path '*/target/*' -not -path '*/.tmp/*' | sort); do
      echo "pre-push: cargo test --manifest-path $m" >&2
      gate cargo test --offline --manifest-path "$wt/$m" || return $?
    done
    echo "pre-push: dialect gate (scripts/dialect_check_v02.py)" >&2 &&
    gate env -C "$wt" python3 scripts/dialect_check_v02.py --json "$wt/scripts/.tmp/pre-push-gate.json"
  }
  run_gate || status=$?
  cleanup
  trap - EXIT
  [ "$status" -eq 0 ] || break
done
exit "$status"
